{
  "expo": {
    "name": "Orbit",
    "slug": "orbit",
    "version": "2.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.tamelabs.orbit" },
    "android": { "package": "com.tamelabs.orbit", "permissions": ["android.permission.READ_CONTACTS", "android.permission.READ_CALENDAR", "android.permission.WRITE_CALENDAR"] },
    "web": { "bundler": "metro" },
    "plugins": [
      "expo-sqlite",
      [
        "expo-contacts",
        { "contactsPermission": "Orbit needs access to your contacts to import them locally. Your contacts never leave your device." }
      ],
      [
        "expo-calendar",
        { "calendarPermission": "Orbit uses calendar to sync birthday reminders." }
      ]
    ]
  }
}
